# Режим 'internal': одно имя ${PUBLIC_HOST}.${DNS_ZONE} обслуживает и инференс,
# и админку LiteLLM. Сертификат выпускает локальный CA командой
# 'model.sh gateway internal'; корень для клиентов — ${TLS_CERTS_DIR}/internal-ca.crt.

server {
	listen 8443 ssl;
	http2 on;
	server_name ${PUBLIC_HOST}.${DNS_ZONE};

	ssl_certificate     /etc/nginx/certs/${TLS_INTERNAL_CERT_FILE};
	ssl_certificate_key /etc/nginx/certs/${TLS_INTERNAL_KEY_FILE};

	include /etc/nginx/routes/api.conf;

	# Всё, что не /v1, — управляющий API. Значение ADMIN_ALLOW_CIDR по умолчанию
	# 'all': иначе админка не открылась бы с другой машины, ради чего одно общее
	# имя и заводилось. Сузьте до своей подсети, как только адреса известны.
	location / {
		allow ${ADMIN_ALLOW_CIDR};
		deny all;
		include /etc/nginx/routes/admin.conf;
	}
}
