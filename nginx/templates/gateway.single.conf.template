# Запасной вариант для площадок, где нельзя создать две DNS-записи.
# Одно имя обслуживает обе роли: /v1/* уходит в LiteLLM, остальное — в Open WebUI.
# PUBLIC_CHAT_HOST в этом режиме не используется.
#
# Команда 'model.sh gateway' этот файл не выбирает. Подключайте явно:
#   NGINX_CONFIG_FILE=./nginx/templates/gateway.single.conf.template \
#     docker compose --profile gateway up -d nginx
#
# Компромиссы описаны в docs/network-and-tls.md: API и UI делят cookies и origin,
# и к ним больше нельзя применить разные политики firewall и доступа.

server {
	listen 8443 ssl;
	http2 on;
	server_name ${PUBLIC_API_HOST};

	ssl_certificate     /etc/nginx/certs/${TLS_INTERNAL_CERT_FILE};
	ssl_certificate_key /etc/nginx/certs/${TLS_INTERNAL_KEY_FILE};

	location = /v1 {
		include /etc/nginx/routes/to_litellm.conf;
	}

	location ^~ /v1/ {
		include /etc/nginx/routes/to_litellm.conf;
	}

	location / {
		include /etc/nginx/routes/to_openwebui.conf;
	}
}
