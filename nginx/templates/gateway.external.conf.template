# Режим 'external': оба имени обслуживаются готовой парой
# ${TLS_CERTS_DIR}/${TLS_CERT_FILE} и ${TLS_CERTS_DIR}/${TLS_KEY_FILE}.
# Файл сертификата должен содержать полную цепочку без корня.
#
# Ключ обязан быть читаемым для UID 101, под которым работает nginx в
# контейнере. Проверку выполняет 'model.sh gateway external' до перезапуска.

server {
	listen 8443 ssl;
	http2 on;
	server_name ${PUBLIC_API_HOST};

	ssl_certificate     /etc/nginx/certs/${TLS_CERT_FILE};
	ssl_certificate_key /etc/nginx/certs/${TLS_KEY_FILE};

	include /etc/nginx/routes/api.conf;
}

server {
	listen 8443 ssl;
	http2 on;
	server_name ${PUBLIC_CHAT_HOST};

	ssl_certificate     /etc/nginx/certs/${TLS_CERT_FILE};
	ssl_certificate_key /etc/nginx/certs/${TLS_KEY_FILE};

	include /etc/nginx/routes/chat.conf;
}
