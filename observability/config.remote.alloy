logging {
  level  = "info"
  format = "logfmt"
}

// Метрики нормализуются перед remote_write. Постоянные метки стенда берутся из
// окружения развёртывания; service и model_slot ограничены известными значениями.
prometheus.relabel "remote" {
  forward_to = [prometheus.remote_write.remote.receiver]

  rule {
    action = "labeldrop"
    regex  = "container_label_.*|container_id|id|image"
  }
}

prometheus.remote_write "remote" {
  external_labels = {
    deployment  = sys.env("DEPLOYMENT_ID"),
    environment = sys.env("ENVIRONMENT"),
    site        = sys.env("SITE"),
    instance    = sys.env("INSTANCE_ID"),
  }

  endpoint {
    url          = sys.env("REMOTE_METRICS_URL")
    bearer_token = sys.env("REMOTE_METRICS_TOKEN")

    tls_config {
      ca_file     = sys.env("REMOTE_CA_FILE")
      min_version = "TLS12"
    }
  }
}

prometheus.exporter.cadvisor "docker" {
  docker_host            = "unix:///var/run/docker.sock"
  docker_only            = true
  store_container_labels = false
}

discovery.relabel "cadvisor" {
  targets = prometheus.exporter.cadvisor.docker.targets

  rule {
    target_label = "service"
    replacement  = "cadvisor"
  }

  rule {
    target_label = "model_slot"
    replacement  = "none"
  }

  rule {
    target_label = "instance"
    replacement  = sys.env("INSTANCE_ID")
  }
}

prometheus.scrape "cadvisor" {
  job_name        = "cadvisor"
  targets         = discovery.relabel.cadvisor.output
  forward_to      = [prometheus.relabel.remote.receiver]
  scrape_interval = "15s"
}

// prometheus.exporter.unix поддерживается на целевом хосте Ubuntu. Ограничение
// набора коллекторов делает базовый профиль хоста предсказуемым и не тянет
// необязательные сервисы.
prometheus.exporter.unix "host" {
  procfs_path = "/rootproc"
  rootfs_path = "/rootfs"
  sysfs_path  = "/sys"

  set_collectors = [
    "cpu",
    "filesystem",
    "loadavg",
    "meminfo",
    "netdev",
    "stat",
    "time",
    "uname",
  ]
}

discovery.relabel "host" {
  targets = prometheus.exporter.unix.host.targets

  rule {
    target_label = "service"
    replacement  = "host"
  }

  rule {
    target_label = "model_slot"
    replacement  = "none"
  }

  rule {
    target_label = "instance"
    replacement  = sys.env("INSTANCE_ID")
  }
}

prometheus.scrape "host" {
  job_name        = "host"
  targets         = discovery.relabel.host.output
  forward_to      = [prometheus.relabel.remote.receiver]
  scrape_interval = "15s"
}

prometheus.scrape "litellm" {
  job_name = "litellm"
  targets = [{
    "__address__" = "litellm:4000",
    "instance"    = sys.env("INSTANCE_ID"),
    "model_slot"  = "none",
    "service"     = "litellm",
  }]
  forward_to      = [prometheus.relabel.remote.receiver]
  scrape_interval = "15s"
}

// Цели профилей заданы статически намеренно. Если профиль модели неактивен,
// Alloy продолжает работать и отдаёт по этой цели up=0.
prometheus.scrape "vllm_main" {
  job_name = "vllm-main"
  targets = [{
    "__address__" = "vllm-main:8000",
    "instance"    = sys.env("INSTANCE_ID"),
    "model_slot"  = "main",
    "service"     = "vllm-main",
  }]
  forward_to      = [prometheus.relabel.remote.receiver]
  scrape_interval = "15s"
}

prometheus.scrape "vllm_alt" {
  job_name = "vllm-alt"
  targets = [{
    "__address__" = "vllm-alt:8000",
    "instance"    = sys.env("INSTANCE_ID"),
    "model_slot"  = "alt",
    "service"     = "vllm-alt",
  }]
  forward_to      = [prometheus.relabel.remote.receiver]
  scrape_interval = "15s"
}

prometheus.scrape "gpu" {
  job_name = "nvidia-gpu"
  targets = [{
    "__address__" = "nvidia-gpu-exporter:9835",
    "instance"    = sys.env("INSTANCE_ID"),
    "model_slot"  = "none",
    "service"     = "nvidia-gpu-exporter",
  }]
  forward_to      = [prometheus.relabel.remote.receiver]
  scrape_interval = "15s"
}

prometheus.scrape "alloy" {
  job_name = "alloy"
  targets = [{
    "__address__" = "alloy:12345",
    "instance"    = sys.env("INSTANCE_ID"),
    "model_slot"  = "none",
    "service"     = "alloy",
  }]
  forward_to      = [prometheus.relabel.remote.receiver]
  scrape_interval = "15s"
}

discovery.docker "local" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "docker_logs" {
  targets = []

  rule {
    target_label = "service"
    replacement  = "docker"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex         = "(.+)"
    target_label  = "service"
  }

  rule {
    target_label = "model_slot"
    replacement  = "none"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex         = "vllm-(main|alt)"
    target_label  = "model_slot"
    replacement   = "$1"
  }
}

loki.source.docker "local" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.local.targets
  labels        = {}
  relabel_rules = discovery.relabel.docker_logs.rules
  forward_to    = [loki.process.redact.receiver]
}

// vLLM печатает при старте дамп разрешённых аргументов, а LiteLLM на некоторых
// путях ошибок может вывести bearer-токен. В режиме remote такие секреты
// полностью покинули бы хост, поэтому маскирование выполняется до отправки
// в Loki заказчика.
loki.process "redact" {
  forward_to = [loki.write.remote.receiver]

  stage.replace {
    expression = "(sk-[A-Za-z0-9_\\-]{8,})"
    replace    = "***REDACTED***"
  }

  stage.replace {
    expression = "(?i)(authorization|api[_-]?key|bearer)([\"'’:= ]+)([A-Za-z0-9_\\-\\.]{8,})"
    replace    = "${1}${2}***REDACTED***"
  }
}

loki.write "remote" {
  external_labels = {
    deployment  = sys.env("DEPLOYMENT_ID"),
    environment = sys.env("ENVIRONMENT"),
    site        = sys.env("SITE"),
    instance    = sys.env("INSTANCE_ID"),
  }

  endpoint {
    url          = sys.env("REMOTE_LOKI_URL")
    bearer_token = sys.env("REMOTE_LOKI_TOKEN")

    tls_config {
      ca_file     = sys.env("REMOTE_CA_FILE")
      min_version = "TLS12"
    }
  }
}

// Приложения могут подключаться по OTLP/gRPC или OTLP/HTTP, но к выходу
// подключены только трейсы. Метрики и логи идут через scrape и конвейер Docker.
otelcol.receiver.otlp "applications" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }

  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    traces = [otelcol.processor.transform.stand_labels.input]
  }
}

otelcol.processor.transform "stand_labels" {
  error_mode = "propagate"

  trace_statements {
    context = "resource"
    statements = [
      string.format("set(attributes[\"deployment\"], %q)", sys.env("DEPLOYMENT_ID")),
      string.format("set(attributes[\"environment\"], %q)", sys.env("ENVIRONMENT")),
      string.format("set(attributes[\"site\"], %q)", sys.env("SITE")),
      string.format("set(attributes[\"instance\"], %q)", sys.env("INSTANCE_ID")),
      `set(attributes["service"], attributes["service.name"]) where attributes["service.name"] != nil`,
      `set(attributes["service"], "unknown") where attributes["service"] == nil`,
      `set(attributes["model_slot"], "none")`,
    ]
  }

  output {
    traces = [otelcol.exporter.otlphttp.remote.input]
  }
}

otelcol.auth.bearer "remote" {
  token = sys.env("REMOTE_TEMPO_TOKEN")
}

otelcol.exporter.otlphttp "remote" {
  client {
    endpoint = sys.env("REMOTE_TEMPO_ENDPOINT")
    auth     = otelcol.auth.bearer.remote.handler

    tls {
      ca_file  = sys.env("REMOTE_CA_FILE")
      insecure = false
    }
  }
}
