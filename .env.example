# Copy this file to .env and replace every CHANGE_ME value.

# Authentication and persistence
POSTGRES_DB=litellm
POSTGRES_USER=litellm
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_POSTGRES_PASSWORD
LITELLM_MASTER_KEY=sk-CHANGE_ME_LONG_RANDOM_MASTER_KEY
LITELLM_SALT_KEY=sk-CHANGE_ME_STABLE_SALT_KEY
VLLM_API_KEY=sk-CHANGE_ME_RANDOM_INTERNAL_VLLM_KEY
# Generate this virtual key after LiteLLM starts, then restart Open WebUI.
OPEN_WEBUI_LITELLM_KEY=
WEBUI_SECRET_KEY=CHANGE_ME_64_HEX_WEBUI_SECRET
WEBUI_ENABLE_SIGNUP=false
STORE_PROMPTS_IN_SPEND_LOGS=false
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_LONG_RANDOM_GRAFANA_PASSWORD

# Hugging Face token is only required for gated models.
HF_TOKEN=

# Validated nightly snapshot. Update the image digest and model revisions deliberately.
VLLM_IMAGE=vllm/vllm-openai@sha256:24f2f8975d011ea7f7066a547886a08a1fd3c4bf0880463487fae4f01ce723c6

# Main profile: community AWQ-quantized multimodal Qwen3.5 for a 12 GB GPU.
MAIN_MODEL_ID=QuantTrio/Qwen3.5-4B-AWQ
MAIN_MODEL_REVISION=32c292e3a73afe1138518180b1b6d2868c980ee2
MAIN_SERVED_MODEL_NAME=qwen3.5-4b-awq
MAIN_VLLM_MAX_MODEL_LEN=8192
MAIN_VLLM_GPU_MEMORY_UTILIZATION=0.85
MAIN_CPU_OFFLOAD_GB=0
MAIN_REASONING_PARSER=qwen3
MAIN_TOOL_CALL_PARSER=qwen3_coder
MAIN_MAX_IMAGES=2
# Keep media.invalid to block remote image_url fetches; data: URLs still work.
VLLM_ALLOWED_MEDIA_DOMAINS=media.invalid
MAIN_VLLM_PORT=8001

# Alternate profile: quantized text model served as qwen3-4b-awq.
ALT_MODEL_ID=Qwen/Qwen3-4B-AWQ
ALT_MODEL_REVISION=74d4bd2bd4bff9cafc9345221320bffb08b406a3
ALT_SERVED_MODEL_NAME=qwen3-4b-awq
ALT_MAX_MODEL_LEN=16384
ALT_VLLM_GPU_MEMORY_UTILIZATION=0.85
ALT_REASONING_PARSER=qwen3
ALT_VLLM_PORT=8002

# Gateway. Internal CA is the safe quick-start mode.
GATEWAY_MODE=internal
CADDY_CONFIG_FILE=./caddy/Caddyfile.internal
PUBLIC_API_HOST=api.vlm.local
PUBLIC_CHAT_HOST=chat.vlm.local
OLD_PUBLIC_API_HOST=
OLD_PUBLIC_CHAT_HOST=
PUBLIC_BIND_ADDRESS=0.0.0.0
PUBLIC_HTTPS_PORT=443
TLS_CERTS_DIR=./secrets/caddy
TLS_CERT_FILE=server.crt
TLS_KEY_FILE=server.key

# Observability. Remote endpoints are required only in remote mode.
OBSERVABILITY_MODE=local
ALLOY_CONFIG_FILE=./observability/config.alloy
DEPLOYMENT_ID=ai-vllm-pilot-01
ENVIRONMENT=pilot
SITE=local
INSTANCE_ID=vlm-host-01
OTEL_TRACES_SAMPLER_ARG=1.0
REMOTE_METRICS_URL=
REMOTE_METRICS_TOKEN=
REMOTE_LOKI_URL=
REMOTE_LOKI_TOKEN=
REMOTE_TEMPO_ENDPOINT=
REMOTE_TEMPO_TOKEN=
REMOTE_CA_DIR=./secrets/remote-ca
# Use /etc/alloy/remote-ca/root.crt for a mounted private CA.
REMOTE_CA_FILE=/etc/ssl/certs/ca-certificates.crt

# Explicit safety switch for running more than one model.
ALLOW_CONCURRENT_MODELS=false

# Loopback-only diagnostic ports
LITELLM_PORT=4000
OPEN_WEBUI_PORT=3000
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090
ALLOY_PORT=12345

# Data retention
PROMETHEUS_RETENTION_TIME=30d
PROMETHEUS_RETENTION_SIZE=10GB
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILES=3

# Pinned service versions. Update deliberately, not via floating latest/main tags.
POSTGRES_VERSION=17-alpine
LITELLM_VERSION=v1.90.5
OPEN_WEBUI_VERSION=v0.10.2
PROMETHEUS_VERSION=v3.4.1
LOKI_VERSION=3.5.1
TEMPO_VERSION=2.8.1
ALLOY_VERSION=v1.17.1
GRAFANA_VERSION=13.1.1
NVIDIA_EXPORTER_VERSION=1.3.2
CADDY_VERSION=2.10.2-alpine
