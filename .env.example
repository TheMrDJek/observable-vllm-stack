# Скопируйте этот файл в .env и замените каждое значение CHANGE_ME.
# Скрипты откажутся стартовать, пока остался хотя бы один placeholder.
# Комментарии игнорируются, поэтому CHANGE_ME в этой строке безвреден.
#
# Генерация секретов (Linux):
#   echo "sk-$(openssl rand -hex 24)"   # ключи LiteLLM и vLLM
#   openssl rand -base64 24             # пароли
# Вариант для Windows PowerShell — в docs/troubleshooting.md.

# ---------------------------------------------------------------------------
# Аутентификация и хранение
# ---------------------------------------------------------------------------
POSTGRES_DB=litellm
POSTGRES_USER=litellm
# Должен совпадать с паролем, которым был инициализирован volume базы. Поздняя
# смена НЕ перешифровывает существующий volume: PostgreSQL не стартует, и пароль
# придётся менять командой ALTER USER внутри контейнера.
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_POSTGRES_PASSWORD

# Административный ключ LiteLLM: создаёт и отзывает virtual keys, задаёт лимиты
# и бюджеты. Никогда не выдавайте его клиентам.
LITELLM_MASTER_KEY=sk-CHANGE_ME_LONG_RANDOM_MASTER_KEY

# Учётные данные для входа в админку LiteLLM (/ui). Задайте пароль обязательно:
# при пустом значении LiteLLM пускает по имени admin с master-ключом вместо
# пароля, то есть ключ управления всем стеком вводится в форму в браузере и
# оседает в менеджерах паролей. При одном публичном имени админка доступна из
# сети, поэтому отдельный пароль — не формальность.
LITELLM_UI_USERNAME=admin
LITELLM_UI_PASSWORD=CHANGE_ME_LONG_RANDOM_UI_PASSWORD

# Шифрует virtual keys, хранящиеся в PostgreSQL. ФИКСИРУЕТСЯ НА ВСЮ ЖИЗНЬ
# СТЕНДА: после смены все ранее выданные ключи невозможно расшифровать, и они
# перестают работать. Резервируйте вместе с базой.
LITELLM_SALT_KEY=sk-CHANGE_ME_STABLE_SALT_KEY

# Внутренний ключ только между LiteLLM и vLLM. Клиенты его не видят. Передаётся
# в контейнер переменной окружения, а не аргументом --api-key: аргументы
# командной строки читает любой локальный пользователь через /proc/<pid>/cmdline.
VLLM_API_KEY=sk-CHANGE_ME_RANDOM_INTERNAL_VLLM_KEY

# true записывает полные prompts и responses в spend logs LiteLLM, то есть в
# PostgreSQL. Включайте только на согласованное окно отладки с политикой
# хранения и доступа, но не по умолчанию на данных заказчика.
STORE_PROMPTS_IN_SPEND_LOGS=false

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_LONG_RANDOM_GRAFANA_PASSWORD

# Нужен только для gated или приватных моделей Hugging Face. Используйте
# read-only токен с минимальным scope. В air-gap бесполезен: готовьте файлы.
HF_TOKEN=

# ---------------------------------------------------------------------------
# Образы и модели
# ---------------------------------------------------------------------------
# Релизный тег, а не ветка nightly и не голый digest. Ветка nightly указывает на
# новую сборку каждый день — её значение вообще не определено без digest, а
# digest в свою очередь ничего не сообщает человеку о версии. Релизный тег даёт
# и воспроизводимость, и читаемость: видно, насколько сборка устарела.
#
# Версия vLLM — это контракт совместимости с архитектурой модели: поддержка
# новых семейств появляется в конкретных релизах. Поэтому тег точный, а не
# плавающий, и обновляется отдельным коммитом с проверкой на стенде.
#
# Для строгой неизменности можно дописать digest — тогда тег останется подписью
# для человека, а Docker будет резолвить по хешу:
#   vllm/vllm-openai:v0.27.1@sha256:1c8e60a0841b333c700488cb029d3664807249da0c071e862191b00fe34b228c
VLLM_IMAGE=vllm/vllm-openai:v0.27.1

# Слот main — единственный, который здесь настраивается. Слот alt существует в
# compose.yaml, но работает на инлайновых дефолтах (Qwen/Qwen3-4B-AWQ), поэтому
# блока ALT_* тут нет: пока слот не запущен, он не потребляет ничего.
# Переключение между ними — 'model.sh start main' / 'model.sh start alt', каждая
# команда останавливает остальные слоты. Одновременный запуск — 'start-many' и
# ALLOW_CONCURRENT_MODELS=true, но на 12 GB две полноценные модели не помещаются.
# Переопределять ALT_* здесь нужно, только если не устраивают дефолты.
#
# Community-сборка AWQ-квантованной мультимодальной Qwen3.5 для карты на 12 GB.
# Апгрейд на 9B для той же карты — заменить три строки ниже на:
#   MAIN_MODEL_ID=QuantTrio/Qwen3.5-9B-AWQ
#   MAIN_MODEL_REVISION=938f8e3ef86c9d1e9bec3705e149694c172592f1
#   MAIN_SERVED_MODEL_NAME=qwen3.5-9b-awq
# и синхронно поправить model_name и model в config/litellm.yaml. Веса займут
# примерно вдвое больше VRAM, поэтому вместе с этим снизьте
# MAIN_VLLM_GPU_MEMORY_UTILIZATION до 0.80 и держите MAIN_VLLM_MAX_MODEL_LEN
# на 8192, пока не убедитесь, что запас есть.
MAIN_MODEL_ID=QuantTrio/Qwen3.5-4B-AWQ
# Неизменяемый commit репозитория модели. Имя ветки не воспроизводимо.
MAIN_MODEL_REVISION=32c292e3a73afe1138518180b1b6d2868c980ee2
# Публичное API-имя, которое клиенты передают в поле "model". ОБЯЗАНО совпадать
# с model_name в config/litellm.yaml, иначе маршрут ломается и модель пропадает
# из /v1/models.
MAIN_SERVED_MODEL_NAME=qwen3.5-4b-awq
# Окно контекста в токенах: system prompt + история + описания tools +
# изображения + ответ. Определяет размер KV-cache; удвоение примерно вдвое
# сокращает число одновременных запросов, помещающихся в VRAM.
MAIN_VLLM_MAX_MODEL_LEN=8192
# Доля всей VRAM, которую процесс vLLM может зарезервировать, ВКЛЮЧАЯ веса. Это
# бюджет процесса, а не «память под веса». Два слота по 0.85 на одной карте
# столкнутся.
MAIN_VLLM_GPU_MEMORY_UTILIZATION=0.85
# Сколько GiB весов вытеснить в оперативную память, если они не помещаются в
# VRAM. Ненулевые значения сильно снижают скорость; лучше взять модель меньше
# или квантованную сильнее.
MAIN_CPU_OFFLOAD_GB=0
# Дополнительные флаги vLLM для этого слота, специфичные для семейства модели.
# Одна строка, разбивается по пробелам. ПУСТОЕ значение = никаких флагов; это
# и нужно для моделей без reasoning и tool calling (например OCR-моделей).
# Закомментируйте строку целиком, чтобы вернуть дефолт для Qwen ниже.
MAIN_EXTRA_ARGS=--enforce-eager --reasoning-parser qwen3 --enable-auto-tool-choice --tool-call-parser qwen3_coder --limit-mm-per-prompt.image 2
# Домены, с которых vLLM разрешено скачивать image_url. Фиктивное значение по
# умолчанию блокирует все внешние загрузки; base64 data: URL продолжают
# работать. Расширение списка означает принятие SSRF-риска разрешённых доменов
# и их DNS — никогда не добавляйте внутренние и metadata-адреса.
VLLM_ALLOWED_MEDIA_DOMAINS=media.invalid
# Диагностический порт слота, только на loopback.
MAIN_VLLM_PORT=8001

# ---------------------------------------------------------------------------
# Gateway. Internal CA — безопасный режим быстрого старта.
# ---------------------------------------------------------------------------
# NGINX_CONFIG_FILE — это то, что nginx реально загружает. GATEWAY_MODE лишь
# фиксирует выбор для человека и для 'model.sh preflight'. Обе переменные
# перезаписываются здесь командой 'model.sh gateway <режим>', поэтому обычный
# 'docker compose up' не откатит режим.
GATEWAY_MODE=internal
NGINX_CONFIG_FILE=./nginx/templates/gateway.internal.conf.template

# Единственное публичное имя стека собирается из короткого имени стенда и зоны:
# vlm + rpa.local = vlm.rpa.local. Метка зоны нужна, чтобы развёртывания разных
# заказчиков не занимали одинаковые записи в DNS — иначе второй LiteLLM на той
# же сети конфликтует с первым.
#
# Имя обслуживает и инференс (/v1/*), и админку LiteLLM (всё остальное).
# Внимание: суффикс .local зарезервирован под mDNS, и Avahi/Bonjour перехватывают
# его независимо от меток перед ним. Для постоянной эксплуатации задайте зону
# поддоменом домена, которым владеете: DNS_ZONE=rpa.example.com.
PUBLIC_HOST=vlm
DNS_ZONE=rpa.local

# Только для 'gateway migration': прежнее полное имя вместе с его зоной, которое
# обслуживается параллельно на время окна смены DNS. В остальных случаях пусто.
OLD_PUBLIC_HOST=

# Кто может обращаться к административным путям LiteLLM: /ui, /key/*, /user/*,
# /spend/*. Значение 'all' открывает их всем, кто дотянулся до имени, — это
# осознанный дефолт, иначе админка не откроется с другой машины. Как только
# адреса рабочих мест известны, сузьте: ADMIN_ALLOW_CIDR=192.168.1.0/24
# За этими путями стоит управление ключами, лимитами и бюджетами всего стека.
ADMIN_ALLOW_CIDR=all

# Интерфейс, на котором публикуется nginx. 0.0.0.0 здесь намеренно: это
# единственная публичная точка входа. Все остальные сервисы привязаны в
# compose.yaml к 127.0.0.1 — не меняйте их на 0.0.0.0 «на время».
PUBLIC_BIND_ADDRESS=0.0.0.0
PUBLIC_HTTPS_PORT=443

# Каталог с TLS-материалом шлюза. Не хранится в Git, образец — в
# secrets.example/tls. Здесь же 'model.sh gateway internal' создаёт файлы
# локального CA: internal-ca.crt (его ставят клиентам), internal-ca.key,
# internal.crt и internal.key.
TLS_CERTS_DIR=./secrets/tls

# Сертификат и ключ заказчика для режимов 'gateway external' и
# 'gateway migration'. Скрипты проверяют наличие файлов, читаемость ключа для
# UID 101 и прогоняют nginx -t, но НЕ проверяют SAN, срок действия и
# соответствие ключа сертификату — это делает оператор.
TLS_CERT_FILE=server.crt
TLS_KEY_FILE=server.key

# Файлы, которые выпускает локальный CA. Меняйте только вместе с содержимым
# TLS_CERTS_DIR: скрипт выпуска и шаблоны nginx ссылаются на эти имена.
TLS_INTERNAL_CERT_FILE=internal.crt
TLS_INTERNAL_KEY_FILE=internal.key

# Предельный размер запроса к шлюзу. 0 = без ограничения, как было у Caddy.
# Значение вроде 64m стоит выставлять осознанно: слишком низкий предел ломает
# мультимодальные запросы с картинками, передаваемыми в base64.
NGINX_CLIENT_MAX_BODY_SIZE=0

# ---------------------------------------------------------------------------
# Наблюдаемость
# ---------------------------------------------------------------------------
# local  = Alloy плюс Prometheus/Loki/Tempo/Grafana на этом хосте
# remote = только Alloy, отправка во внешний LGTM по TLS
# off    = телеметрия остановлена; приложения работают и пишут ошибки экспорта
# ALLOY_CONFIG_FILE — то, что Alloy реально загружает; OBSERVABILITY_MODE лишь
# фиксирует выбор. Обе перезаписываются командой 'model.sh observability <режим>'.
OBSERVABILITY_MODE=local
ALLOY_CONFIG_FILE=./observability/config.alloy

# Идентификация стенда в метриках, логах и трейсах. Держите значения
# стабильными и низкой кардинальности: они становятся метками на каждой серии.
# Никогда не помещайте сюда revision модели, request id, prompt или текст
# пользователя.
DEPLOYMENT_ID=ai-vllm-pilot-01
ENVIRONMENT=pilot
SITE=local
INSTANCE_ID=vlm-host-01

# Доля сохраняемых трейсов: 1.0 = все. Допустимо для короткого пилота, но
# снизьте значение, прежде чем это станет постоянной production-настройкой.
OTEL_TRACES_SAMPLER_ARG=1.0

# Требуются только при OBSERVABILITY_MODE=remote. Указывайте полные пути
# отправки, а не имена хостов. Токены должны быть write-only. Пока адреса
# неизвестны, оставьте пустыми и работайте в режиме local или off.
REMOTE_METRICS_URL=
REMOTE_METRICS_TOKEN=
REMOTE_LOKI_URL=
REMOTE_LOKI_TOKEN=
REMOTE_TEMPO_ENDPOINT=
REMOTE_TEMPO_TOKEN=

# CA для проверки удалённых endpoints. По умолчанию — системный набор. Для
# приватного CA положите root.crt в REMOTE_CA_DIR и укажите
# REMOTE_CA_FILE=/etc/alloy/remote-ca/root.crt (путь ВНУТРИ контейнера).
REMOTE_CA_DIR=./secrets/remote-ca
REMOTE_CA_FILE=/etc/ssl/certs/ca-certificates.crt

# ---------------------------------------------------------------------------
# Безопасность и лимиты
# ---------------------------------------------------------------------------
# Требуется командой 'start-many'. Проверка VRAM не выполняется: включая этот
# флаг, вы утверждаете, что обе модели вместе с KV-cache помещаются. На карте
# 12 GB они обычно не помещаются.
ALLOW_CONCURRENT_MODELS=false

# Диагностические порты только на loopback. С других машин недоступны,
# используйте SSH-тоннель. Меняйте только при конфликте портов.
LITELLM_PORT=4000
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090
ALLOY_PORT=12345

# Prometheus останавливается по тому пределу, который достигнут раньше. У Loki
# и Tempo в этой конфигурации ограничения нет — следите за диском.
PROMETHEUS_RETENTION_TIME=30d
PROMETHEUS_RETENTION_SIZE=10GB
# Ротация логов на контейнер. Худший случай суммарно — размер x файлы x контейнеры.
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILES=3

# ---------------------------------------------------------------------------
# Закреплённые версии сервисов. Обновляйте осознанно, а не плавающими тегами
# latest/main.
# ---------------------------------------------------------------------------
POSTGRES_VERSION=17-alpine
LITELLM_VERSION=v1.96.2
PROMETHEUS_VERSION=v3.4.1
LOKI_VERSION=3.5.1
TEMPO_VERSION=2.8.1
ALLOY_VERSION=v1.17.1
GRAFANA_VERSION=13.1.1
NVIDIA_EXPORTER_VERSION=1.3.2
NGINX_VERSION=1.29-alpine
# Образ используется только одноразовым контейнером выпуска локального CA.
OPENSSL_VERSION=3.5.4
