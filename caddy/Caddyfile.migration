{
	auto_https disable_redirects
	https_port 8443
	servers {
		protocols h1 h2
	}
}

import /etc/caddy/routes.caddy

https://{$OLD_PUBLIC_API_HOST}:8443 {
	tls internal
	import api_route
}

https://{$OLD_PUBLIC_CHAT_HOST}:8443 {
	tls internal
	import chat_route
}

https://{$PUBLIC_API_HOST}:8443 {
	tls /etc/caddy/certs/{$TLS_CERT_FILE} /etc/caddy/certs/{$TLS_KEY_FILE}
	import api_route
}

https://{$PUBLIC_CHAT_HOST}:8443 {
	tls /etc/caddy/certs/{$TLS_CERT_FILE} /etc/caddy/certs/{$TLS_KEY_FILE}
	import chat_route
}
