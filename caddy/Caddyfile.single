# Запасной вариант для площадок, где нельзя создать две DNS-записи.
# Одно имя обслуживает обе роли: /v1/* уходит в LiteLLM, остальное — в Open WebUI.
# PUBLIC_CHAT_HOST в этом режиме не используется.
#
# Команда 'model.sh gateway' этот файл не выбирает. Подключайте явно:
#   CADDY_CONFIG_FILE=./caddy/Caddyfile.single docker compose --profile gateway up -d caddy
#
# Компромиссы описаны в docs/network-and-tls.md: API и UI делят cookies и origin,
# и к ним больше нельзя применить разные политики firewall и доступа.
{
	auto_https disable_redirects
	https_port 8443
	servers {
		protocols h1 h2
	}
}

import /etc/caddy/routes.caddy

https://{$PUBLIC_API_HOST}:8443 {
	tls internal

	@openai path /v1 /v1/*
	handle @openai {
		reverse_proxy litellm:4000 {
			flush_interval -1
			transport http {
				dial_timeout 10s
				response_header_timeout 10m
				read_timeout 10m
				write_timeout 10m
			}
		}
	}

	handle {
		import chat_route
	}
}
